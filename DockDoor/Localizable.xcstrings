          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר את התצוגה המקדימה מוצמדת למקום שבו היה סמל ה-Dock כאשר רחפו עליו לראשונה, ומונע ממנה לקפוץ כאשר ה-Dock מסתתר אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene l'anteprima fissata dove si trovava l'icona del dock al momento dell'attivazione (resta visibile se il Dock si nasconde automaticamente)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初にホバーしたときにドックアイコンがある場所にプレビューを固定したままにし、ドックが自動的に隠れたときに飛ばないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt het voorbeeld vast op de plek waar het Dock-pictogram zich bevond toen de muisaanwijzer er voor het eerst overheen ging, om te voorkomen dat het verschuift wanneer het Dock automatisch verborgen wordt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При наведении курсора на значок док-панели, предварительный просмотр остается на том же месте, что и при наведении, и не смещается при автоматическом скрытии док-панели."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizlemeyi, fare imlecini ilk kez üzerine getirdiğinizde dock simgesinin bulunduğu yerde sabit tutar ve dock otomatik olarak gizlendiğinde yerinin değişmesini önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeps the preview pinned where the dock icon was when first hovered, preventing it from jumping when the dock auto-hides."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ bản xem trước cố định tại vị trí biểu tượng dock khi di chuột lần đầu, tránh bị nhảy khi dock tự ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将预览固定在第一次悬停时dock图标的位置，防止它在dock自动隐藏时跳跃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將預覽釘選在一開始指標停留在Dock圖像上時的位置，防止預覽在Dock自動隱藏時跳動。"
          }
        }
      }
    },
