        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахивание по превью окон во всплывающем окне Dock. Направление относительно положения Dock - смахивайте в сторону Dock (например, вниз, если Dock внизу; влево, если Dock слева)"
          }
        },
        "sr" : {
          "stringUnit" : {
