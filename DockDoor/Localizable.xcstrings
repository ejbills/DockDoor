          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets the max rows (for bottom/top Dock) or columns (for side Dock) previews will use. '0' dynamically determines fit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die maximale Anzahl der Zeilen (für das untere/obere Dock) oder Spalten (für das seitliche Dock) fest, die für die Vorschau verwendet werden. '0' bestimmt dynamisch die Anpassung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets the max rows (for bottom/top Dock) or columns (for side Dock) previews will use. '0' dynamically determines fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece las filas máximas (para la parte inferior/superior de Dock) o las previsualizaciones (para la parte de acoplamiento). '0' determina dinámicamente que se ajusta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets the max rows (for bottom/top Dock) or columns (for side Dock) previews will use. '0' dynamically determines fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit le nombre maximum de lignes (pour un Dock situé en bas) ou de colonnes (pour un Dock latéral) pour les aperçus. « 0 » détermine dynamiquement l’ajustement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגדיר את מספר השורות המקסימלי (עבור Dock תחתון/עליון) או עמודות (עבור Dock צדדי) שתצוגות מקדימות ישתמשו בהן. '0' קובע התאמה באופן דינמי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets the max rows (for bottom/top Dock) or columns (for side Dock) previews will use. '0' dynamically determines fit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja a maximális sorok számát (alsó/felső Dock) vagy oszlopok számát (oldalsó Dock), amelyet az előnézetek használnak. A ‘0’ érték automatikusan határozza meg a megfelelőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets the max rows (for bottom/top Dock) or columns (for side Dock) previews will use. '0' dynamically determines fit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il numero massimo di righe (per Dock in basso / in alto) o di colonne (per Dock laterale) che le anteprime avranno a disposizione. Con '0' il valore è determinato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューで使用する最大行数（下部/上部Dockの場合）または最大列数（側面ドックの場合）を設定します。'0' を指定すると、画面に収まるように動的に決定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기에서 사용할 최대 행(하단/상단 Dock의 경우) 또는 열(측면 Dock의 경우)을 설정합니다. '0'은 동적으로 맞춤을 결정합니다."
          }
