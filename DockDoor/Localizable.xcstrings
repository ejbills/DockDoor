        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen uygulamalar yalnızca en son pencerelerini gösterir. Tüm pencereler “yalnızca etkin uygulamalar” modunda gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрані застосунки показують лише своє останнє вікно. Усі вікна відображаються лише в режимі активного застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng được chọn chỉ hiển thị cửa sổ gần đây nhất của chúng. Tất cả cửa sổ sẽ được hiển thị trong chế độ chỉ hiển thị ứng dụng đang hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选定的应用程序只显示其最近的窗口。所有窗口均以活动应用专用模式显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇只要顯示最近使用的視窗的App。在「僅限最近使用的App」模式中，所有視窗都會顯示。"
          }
        }
      }
    },
