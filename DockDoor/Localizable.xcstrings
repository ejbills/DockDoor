    "If you find DockDoor useful, consider donating. Your support helps keep the project going!" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you find DockDoor useful, consider donating. Your support helps keep the project going!"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وجدت أن DockDoor مفيد، ففكر في التبرع. فدعمك يساعد في استمرار المشروع!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you find DockDoor useful, consider donating. Your support helps keep the project going!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se vám DockDoor líbí, zvažte dar. Vaše podpora nám pomáhá v projektu pokračovat!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder man DockDoor nyttig, overvej at donere. Enhver støtte hjælper med at holde projektet i gang!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie DockDoor nützlich finden, erwägen Sie zu spenden. Ihre Unterstützung hilft, das Projekt am Laufen zu halten!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you find DockDoor useful, consider donating. Your support helps keep the project going!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
