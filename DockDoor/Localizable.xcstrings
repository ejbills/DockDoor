        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa alla modalità compatta al raggiungimento di un certo numero di finestre. Imposta a 0 per disabilitare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが指定数以上のウィンドウを開いた際に自動的にコンパクトモードに切り替えるしきい値を設定します。無効にするには0に設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een drempelwaarde in om automatisch over te schakelen naar de compacte modus wanneer een app dat aantal vensters of meer heeft. Stel deze waarde in op 0 om deze functie uit te schakelen."
          }
        },
