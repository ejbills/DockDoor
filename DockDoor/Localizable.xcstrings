        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisser sur les aperçus de fenêtre dans la popup Dock. La direction est relative à la position du dock — glisser vers le dock (en bas lorsque le dock est en bas, à gauche lorsque le dock est à gauche etc.)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק על תצוגות מקדימות של חלונות בחלון הקופץ של Dock. הכיוון יחסי למיקום ה-Dock — החלק לכיוון ה-Dock (למשל, למטה כאשר ה-Dock בתחתית, שמאלה כאשר ה-Dock בצד שמאל)."
          }
        },
