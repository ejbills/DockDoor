          "stringUnit" : {
            "state" : "translated",
            "value" : "После смены заблокированного экрана, переместить указатель в нижнюю часть этого экрана, чтобы переместить Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After changing the locked screen, move your cursor to the bottom of that screen to relocate the Dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After changing the locked screen, move your cursor to the bottom of that screen to relocate the Dock."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit ekranını değiştirdikten sonra, Dock'u yeniden konumlandırmak için imleci o ekranın altına getirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після зміни заблокованого екрана, перемістіть курсор до низу екрану щоб перемістити Dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi thay đổi màn hình khóa, hãy di chuyển con trỏ xuống cuối màn hình đó để di chuyển lại Dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改锁定屏幕后，将光标移动到该屏幕的底部以重新定位Dock。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更換鎖定Dock的顯示器後，將指標移動到該顯示器底部來使Dock定位。"
          }
        }
      }
    },
