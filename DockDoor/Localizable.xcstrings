    "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládání průhlednosti pozadí náhledu Docku. Nižší hodnoty zvýší průhlednost náhledů, což může snížit překrývání obsahu v oknech náhledy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr gennemsigtigheden af dock-forhåndsvisningens baggrund. Lavere værdier gør forhåndsvisningen mere transparent, hvilket kan hjælpe med at undgå, at den blokerer for vinduesindhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimme die Transparenz des Hintergrundes der Dock-Vorschau. Niedrigere Werte machen die Vorschaue transparenter, was dabei hilft, dass diese den Fensterinhalt blockiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la transparencia del fondo de la vista previa del muelle. Valores más bajos hacen que la vista previa sea más transparente, lo que puede ayudar a evitar que bloquee el contenido de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez la transparence de l’arrière-plan des aperçus du Dock. Des valeurs plus basses rendent l’aperçu plus transparent, ce qui peut aider à l’empêcher de bloquer le contenu de fenêtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלוט בשקיפות רקע התצוגה המקדימה של ה-Dock. ערכים נמוכים יותר הופכים את התצוגה המקדימה לשקופה יותר, מה שיכול לעזור למנוע ממנה לחסום תוכן חלון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsd be a Dock előnézet hátterének átlátszóságát.\nAlacsonyabb értékeknél az előnézet átlátszóbb lesz, ami segít abban, hogy ne takarja ki az ablak tartalmát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasparenza dello sfondo dell'anteprima. Valori piccoli determinano un'anteprima più trasparente (può aiutare a impedire che il contenuto della finestra sia coperto)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockプレビューの背景の透明度を制御します。低い値を使用すると、プレビューが透明になり、ウィンドウの内容をブロックするのを防ぐことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock Preview 배경의 투명도를 설정합니다. 값이 낮을수록 Dock Preview가 더 투명해지며, 창 콘텐츠를 가리는 것을 방지하는 데 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de transparantie van de achtergrond van het Dock-voorbeeld aan. Hoe lager de waarde, hoe transparanter het voorbeeld wordt, zodat de inhoud van het venster niet wordt bedekt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer gjennomsiktighet i forhåndsvisningsbakgrunnen i dokken. Lavere verdier gjør forhåndsvisningen mer gjennomsiktig, noe som kan bidra til å forhindre det fra å blokkere vindusinnhold."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle a transparência do fundo da pré-visualização na Dock. Valores mais baixos tornam a pré-visualização mais transparente, o que ajuda a evitar que esta bloqueie o conteúdo das janelas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет прозрачностью фона превью Dock. Меньшие значения делают превью более прозрачным, что помогает не перекрывать содержимое окон"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Control the transparency of the dock preview background. Lower values make the preview more transparent, which can help prevent it from blocking window content."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock önizlemesinin arka plan saydamlığını kontrol edin. Düşük değerler önizlemeyi daha şeffaf yapar, böylece pencere içeriğinin engellenmesini önlemeye yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керуйте прозорістю фону попереднього перегляду в Dock. Нижчі значення роблять попередній перегляд прозорішим, що може допомогти запобігти блокуванню вмісту вікна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh độ trong suốt của nền bản xem trước Dock. Giá trị thấp hơn làm bản xem trước trong suốt hơn, giúp tránh che khuất nội dung cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 Dock 预览背景的透明度。数值越低，预览越透明，这可避免遮挡窗口内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制Dock預覽背景的透明度。較低的數值會使預覽更透明，有助於避免遮擋視窗內容。"
          }
        }
      }
    },
