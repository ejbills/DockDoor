          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor cần quyền truy cập vào lịch của bạn để hiển thị các sự kiện. Vui lòng bật quyền truy cập Lịch trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > Lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor 需要访问您的日历以显示事件。请在“系统设置”>“隐私与安全”>“日历”中启用日历访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor需要行事曆存取權限來顯示行程。請在系統設定 > 隱私權與安全性 > 行事曆中允許。"
          }
        }
      }
    },
