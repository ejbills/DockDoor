    "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyšší kvalita a snímkovací frekvence více zatěžují CPU a GPU. Pokud pozorujete prodlevy, použijte nižší nastavení pro přepínač oken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Qualität und Bildrate verbraucht mehr CPU/GPU Ressourcen. Nutze niedrigere Einstellungen für Fensterwechsler, wenn du Verzögerungen merkst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une qualité et une fréquence de trame plus élevées consomment plus de ressources CPU/GPU. Utilisez des réglages plus bas pour le sélecteur de fenêtres si vous éprouvez des ralentissements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איכות וקצב פריימים גבוהים יותר משתמשים ביותר משאבי CPU/GPU. השתמש בהגדרות נמוכות יותר עבור בורר חלונות אם אתה חווה עיכובים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jobb minőség és a magasabb képkockasebesség több CPU/GPU erőforrást igényel. Ha akadást tapasztal az ablakváltónál, használjon alacsonyabb beállításokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualità e fluidità superiori utilizzano più risorse CPU/GPU. Abbassa i valori se riscontri ritardi o rallentamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画質とフレームレートが高いほどCPU/GPUリソースが多く使用されます。遅延が発生した場合はウィンドウスイッチャーの設定を下回ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hogere kwaliteit en beeldsnelheid vragen meer van de CPU en GPU. Kies lagere instellingen voor de vensterwisselaar als je last hebt van vertragingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta qualidade e taxa de refrescamento utilizam mais recursos de CPU/GPU. Baixe as configurações para o Alternador de Janelas se experimentar algum atraso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокое качество и частота кадров требуют больше ресурсов CPU/GPU. При торможении переключателя окон используйте более низкие настройки"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Higher quality and frame rate use more CPU/GPU resources. Use lower settings for Window Switcher if you experience lag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek kalite ve kare hızı, daha fazla CPU/GPU kaynağı tüketir. Gecikme yaşarsanız, Window Switcher için daha düşük ayarlar kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вища якість і частота кадрів використовують більше ресурсів процесора/графічного ядра. Використовуйте нижчі налаштування для перемикача вікон, якщо у вас виникають затримки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chất lượng và tốc độ khung hình cao hơn sử dụng nhiều tài nguyên CPU/GPU hơn. Sử dụng cài đặt thấp hơn cho Trình chuyển đổi cửa sổ nếu bạn gặp tình trạng giật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的画质和帧率会占用更多的 CPU/GPU 资源。如果在使用窗口切换器时出现卡顿，请使用较低的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的畫質與影格率會使用更多的 CPU/GPU 資源。若遇到延遲，請將視窗切換器設定調低。"
          }
        }
      }
    },
