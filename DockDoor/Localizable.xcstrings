    "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر جميع معاينات النوافذ بخلفية رمادية. وعند تمرير المؤشر فوقها، تتغير الخلفية إلى لون التمييز أو اللون المخصص الموضح أدناه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny náhledy oken mají šedé pozadí. Po přejetí se pozadí změní na barvu zvýraznění nebo vlastní barvu níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vinduesforhåndsvisninger viser en grå baggrund. Når musen holdes over, ændres baggrunden til accentfarven eller den tilpassede farve nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Fenstervorschauen zeigen einen grauen Hintergrund. Wenn der Mauszeiger auf der Fenstervorschau schwebt, verändert sich der Hintergrund zur Akzentfarbe oder benutzerdefinierten Farbe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las ventanas de vista previa muestran un fondo gris. Al pasarle el ratón por encima, el fondo cambia al color de acento o al color personalizado aquí debajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les aperçus de fenêtres affichent un arrière-plan gris. Quand ils sont survolés, l’arrière-plan prend la couleur d'accentuation ou une couleur personnalisée ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל תצוגות החלונות המקדימות מציגות רקע אפור. בעת ריחוף, הרקע משתנה לצבע המבטא או לצבע מותאם אישית למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden ablakelőnézet szürke háttérrel jelenik meg. Egér fölé húzáskor a háttér az aktuális kiemelőszínre vagy az alább megadott egyéni színre vált."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le anteprime hanno uno sfondo grigio. Al passaggio del mouse, lo sfondo cambia in base alle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのウィンドウのプレビューはグレーの背景を表示します。ホバーすると、下のアクセントカラーまたはカスタムカラーに背景が変更されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 창 미리보기는 회색 배경을 표시합니다. 마우스를 올리면 배경이 아래의 강조 색상 또는 사용자 지정 색상으로 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle venstervoorbeelden tonen een grijze achtergrond. Van de geselecteerde preview verandert de achtergrond in de accentkleur of aangepaste kleur hieronder."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vindusforhåndsvisninger viser en grå bakgrunn. Når musepekeren svever over, endres bakgrunnen til aksentfargen eller egendefinert farge nedenfor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie podglądy okien mają szare tło. Po najechaniu kursorem myszy tło zmienia się na kolor akcentujący lub niestandardowy poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as pré-visualizações de janela mostram um fundo cinza. Quando deixar o mouse sobre, o fundo muda para a cor de destaque ou cor personalizada abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as pré-visualizações de janela mostram um fundo cinza. Quando passar o mouse em cima, o fundo muda para a cor de destaque ou cor personalizada abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все миниатюры окон имеют серый фон. При наведении он меняется на акцентный или выбранный ниже цвет."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All window previews show a gray background. When hovered, the background changes to the accent color or custom color below."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm pencere önizlemeleri gri arka planla gösterilir. Üzerine gelindiğinde arka plan, vurgu rengine veya aşağıda belirtilen özel renge dönüşür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі попередні перегляди вікон мають сірий фон. При наведенні курсора фон змінюється на акцентний колір або власний колір, вказаний нижче."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả bản xem trước cửa sổ sẽ hiển thị nền màu xám. Khi di chuột vào, nền sẽ chuyển sang màu nhấn hoặc màu tùy chỉnh bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有窗口预览均显示灰色背景。悬停时，背景将变为下方的强调色或自定义颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有視窗預覽都會顯示灰色背景。當指標停留時，背景會變為下方的強調色或自訂顏色。"
          }
        }
      }
    },
