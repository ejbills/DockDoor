          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le applicazioni selezionate mostrano solo la finestra più recente (come 'solo applicazione attiva')."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアプリは最新のウィンドウのみを表示します。アクティブアプリのみモードでは全てのウィンドウが表示されます。"
          }
        },
        "ko" : {
