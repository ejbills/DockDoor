            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, при наведении на приложение в Dock отображаются окна всех его экземпляров. Если отключено, показываются только окна конкретного экземпляра под курсором"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu özellik etkinleştirildiğinde, Dock'taki bir uygulamanın üzerine fareyi getirdiğinizde o uygulamanın tüm örneklerine ait pencereler gösterilir. Devre dışı bırakıldığında ise yalnızca farenin bulunduğu konumdaki belirli örneğe ait pencereler gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо цю функцію ввімкнено, наведення курсора на програму в Dock показує вікна всіх екземплярів цієї програми. Якщо цю функцію вимкнено, показуються лише вікна певного екземпляра, на який наведено курсор миші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được bật, di chuột qua ứng dụng trên Dock sẽ hiển thị cửa sổ từ tất cả các phiên bản của ứng dụng đó. Khi tắt, chỉ hiển thị cửa sổ từ phiên bản cụ thể dưới chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用时，将鼠标悬停在 Dock 中的应用上，会显示该应用所有实例的窗口。当禁用时，只显示鼠标下特定实例的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時，指標停留在Dock中的App上方會顯示該App來自所有實體的全部視窗。停用時，只顯示指標所在實體所屬視窗。"
          }
        }
      }
    },
