    "An additional trigger key using the same modifier, invoking the switcher with a different filter mode." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح تشغيل إضافي يستخدم نفس المعدِّل، تشغيل أداة التبديل باستخدام وضع تصفية مختلف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další spouštěcí klíč používající stejný modifikátor vyvolávající přepínač s jiným režimem filtru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zusätzliche Shortcut-Taste, welche denselben Modifikator verwendet und den Fensterwechsler mit einem anderen Filtermodus aufruft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tecla de activación adicional que usa el mismo modificador e invoca el selector con un modo de filtrado distinto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche de déclenchement additionnelle utilisant le même modificateur, invoquant le sélecteur avec un mode de filtre différent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקש הפעלה נוסף המשתמש באותו מקש שינוי, המפעיל את הבורר עם מצב סינון שונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An additional trigger key using the same modifier, invoking the switcher with a different filter mode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy további indító gomb ugyanazzal a módosító billentyűvel, amely eltérő szűrési módban hívja elő a váltót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
