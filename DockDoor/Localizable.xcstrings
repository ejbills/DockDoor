    "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "ar" : {
