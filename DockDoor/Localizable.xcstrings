        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakt modda pencere başlıklarına daha fazla yer açmak için kapatma, küçültme ve diğer pencere kontrol düğmelerini gizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує \"закрити\", \"згорнути\" та інші кнопки керування вікном у компактному режимі щоб надати більше місця для назви вікна."
          }
        },
