          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim uygulamasının üzerine fareyi getirdiğinizde dock önizlemesinde hangi takvimlerin görüneceğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, які календарі відображатимуться в попередньому перегляді Dock під час наведення курсора на застосунок Календар."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn lịch nào sẽ xuất hiện trong bản xem trước dock khi di chuột qua ứng dụng Lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择将鼠标悬停在 Dock 日历应用图标上时，预览中显示的日历。"
          }
