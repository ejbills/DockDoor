          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cmd+A önizlemeleri odaklar, Sol/Sağ tuşlarıyla gezinebilir, Aşağı tuşuyla seçim silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cmd+A фокусує попередній перегляд, навігація ліворуч/праворуч, вниз очищує виділення."
