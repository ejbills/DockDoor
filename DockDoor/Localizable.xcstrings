    "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umístí ovládací prvky a titulky oken přímo do náhledů Docku pro kompaktnější a minimalistický vzhled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platziere Ampeltasten und Fenstertitel direkt in den Dock-Vorschaubildern für ein kompakteres und minimalistischeres Aussehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca los botones de semáforo y los títulos de las ventanas directamente dentro de los marcos de vista previa para una apariencia más compacta y mínima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place les boutons feu tricolore et les titres des fenêtres directement sur les aperçus du Dock pour une apparence plus compacte et minimale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממקם את כפתורי רמזור וכותרות חלונות ישירות בתוך מסגרות התצוגה המקדימה של ה-Dock למראה קומפקטי ומינימליסטי יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelzőlámpa gombokat és az ablakcímeket közvetlenül a Dock előnézet kereteibe helyezi, kompaktabb és letisztultabb megjelenés érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona i tasti azione e i titoli delle finestre all'interno dei riquadri di anteprima per un aspetto più compatto e minimale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よりコンパクトで最小限の外観を実現するために、Dockのプレビューフレーム内にトラフィックボタンやウィンドウのタイトルを直接配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats verkeerslichtknoppen en venstertitels direct in de Dock-voorbeeld vensters voor een compactere en minimalistische uitstraling."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размещение кнопок \"светофора\" и заголовка окна непосредственно внутри рамки превью для более компактного и минималистичного внешнего вида."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Places traffic light buttons and window titles directly inside the dock preview frames for a more compact and minimal appearance."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafik ışığı düğmelerini ve pencere başlıklarını, daha kompakt ve minimalist bir görünüm elde etmek için doğrudan dock önizleme çerçevelerinin içine yerleştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розміщує кнопки світлофора та заголовки вікон безпосередньо всередині рамок попереднього перегляду Dock для більш компактного та мінімалістичного вигляду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt nút đèn tín hiệu và tiêu đề cửa sổ trực tiếp vào khung xem trước Dock để có giao diện gọn gàng và tối giản hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将控制按钮和窗口标题直接置于 Dock 预览框架内，呈现更紧凑简约的外观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將視窗控制按鈕和標題顯示在Dock預覽畫面內，使外觀更加緊湊簡潔。"
          }
        }
      }
    },
