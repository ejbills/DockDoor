        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dock simgesinin üzerine gelip yukarı kaydırarak uygulamayı ön plana getirin, aşağı kaydırarak tüm pencerelerini gizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутіть угору на іконці в Dock, щоб вивести застосунок на передній план, прокрутіть униз, щоб приховати всі його вікна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn lên trên biểu tượng dock để đưa ứng dụng lên trước, cuộn xuống để ẩn tất cả các cửa sổ của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Dock 图标上，向上滚动可以将应用窗口移至最前方，向下滚动可以隐藏此应用所有窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Dock圖像向上捲動來將App移至最前方，向下捲動隱藏其所有視窗。"
          }
        }
      }
    },
    "Scroll up on a focused window title bar to maximize it, scroll down to center it using the configured window size, and scroll left or right to switch desktop spaces. Repeat the same up/down scroll within the configured restore time to restore the previous window size." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll up on a focused window title bar to maximize it, scroll down to center it using the configured window size, and scroll left or right to switch desktop spaces. Repeat the same up/down scroll within the configured restore time to restore the previous window size."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll up on a focused window title bar to maximize it, scroll down to center it using the configured window size, and scroll left or right to switch desktop spaces. Repeat the same up/down scroll within the configured restore time to restore the previous window size."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll up on a focused window title bar to maximize it, scroll down to center it using the configured window size, and scroll left or right to switch desktop spaces. Repeat the same up/down scroll within the configured restore time to restore the previous window size."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na záhlaví okna v popředí rolujte nahoru, abyste jej maximalizovali, rolujte dolů, abyste jej vystředili za použití nastavené velikosti okna, rolujte vlevo či vpravo pro přepnutí ploch. Rolujte nahoru/dolů během nastavené doby obnovení znovu pro obnovení předchozí velikosti okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll up on a focused window title bar to maximize it, scroll down to center it using the configured window size, and scroll left or right to switch desktop spaces. Repeat the same up/down scroll within the configured restore time to restore the previous window size."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle in der Titelleiste eines fokussierten Fensters nach oben, um es zu maximieren, scrolle nach unten, um das Fenster entsprechend der eingestellten Fenstergröße zu zentrieren, und scrolle nach links oder rechts, um zwischen den Desktop-Spaces zu wechseln. Wiederhole dieselbe Auf- und Abbewegung innerhalb der festgelegten Wiederherstellungszeit, um die vorherige Fenstergröße wiederherzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
