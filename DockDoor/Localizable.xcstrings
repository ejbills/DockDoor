          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ修飾子を使用したトリガーキーを追加し、別のフィルターモードでスイッチャーを呼び出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동일한 수정자 키를 사용하여 다른 필터 모드로 전환기를 호출하는 추가 트리거 키입니다."
          }
        },
        "nl" : {
