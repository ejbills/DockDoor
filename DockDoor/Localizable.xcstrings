    "Cmd+%@ cycles forward, Cmd+%@ or Shift+Tab cycles backward, Left/Right navigate, Down clears selection." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cmd+%1$@ cycles forward, Cmd+%2$@ or Shift+Tab cycles backward, Left/Right navigate, Down clears selection."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cmd+%1$@ cycles forward, Cmd+%2$@ or Shift+Tab cycles backward, Left/Right navigate, Down clears selection."
          }
        },
