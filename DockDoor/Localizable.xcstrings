        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está habilitado, mover el ratón de vuelta a la vista previa durante el desvanecimiento no lo reactivará. Debes pasar el cursor sobre el ícono del dock de nuevo para mostrar la previsualización."
          }
        },
        "fi" : {
