    "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakázat widgety při najetí myší na Dock pro vybrané aplikace, přičemž se zachovají jejich běžné náhledy. Vhodné pro prohlížeče s mediálními relacemi jako YouTube."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere für ausgewählte Apps die Widgets beim Bewegen des Mauszeigers über das Dock während normale Vorschauen erhalten bleiben. Nützlich für Browser, welche Medienwiedergaben von zum Beispiel YouTube anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
