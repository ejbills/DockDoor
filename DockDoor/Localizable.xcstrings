            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringe die initiale Verzögerung bevor der Fensterwechsler angezeigt wird. Kann sich schneller anfühlen aber zu flimmern führen, wenn die Taste zu schnell losgelassen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "es" : {
