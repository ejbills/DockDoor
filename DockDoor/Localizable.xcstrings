    "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižší hodnoty zvyšují citlivost gest. Vyšší hodnoty vyžadují delší tahy. Použije se na náhledy Docku i přepínač oken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere Werte machen Gesten empfindlicher. Höhere Werte erfordern längeres Wischen. Gilt sowohl für Dock-Vorschauen als auch für Fensterwechsler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs inférieures rendent les gestes plus sensibles. Des valeurs plus élevées nécessitent des balayages plus longs. S'applique à la fois aux aperçus de l'amarrage et au commutateur de fenêtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים נמוכים יותר הופכים מחוות לרגישות יותר. ערכים גבוהים יותר דורשים החלקות ארוכות יותר. חל על תצוגות מקדימות של Dock ובורר חלונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alacsonyabb értékek érzékenyebbé teszik a gesztusokat. A magasabb értékekhez hosszabb elhúzás szükséges. Érvényes a Dock-előnézetekre és az ablakváltóra is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori inferiori rendono i gesti più sensibili. Valori più alti richiedono scorrimenti più lunghi. Si applica sia alle anteprime del Dock che al selettore finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値を小さくするとジェスチャーがより敏感になります。値を大きくするとスワイプが長くなります。Dockプレビューとウィンドウ切り替えの両方に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij lagere waarden reageren gebaren gevoeliger. Bij hogere waarden moet je langer vegen. Dit geldt zowel voor Dock-voorbeelden als voor de vensterwisselaar."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores baixos deixam os gestos mais sensíveis. Valores altos exigem deslizes mais longos. Aplica-se às prévias do dock e ao alternador de janelas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньшие значения делают жесты более чувствительными. Более высокие значения требуют длинных свайпов. Применяется как к превью, так и к переключателю окон."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower values make gestures more sensitive. Higher values require longer swipes. Applies to both dock previews and window switcher."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha düşük değerler, hareketlerin daha hassas olmasını sağlar. Daha yüksek değerler ise daha uzun kaydırma hareketleri gerektirir. Bu ayar, hem dock önizlemeleri hem de pencere değiştirici için geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижні значення роблять жести чутливішими. Вищі значення вимагають триваліших рухів пальцем. Стосується як попереднього перегляду у Dock, так і Перемикача вікон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị thấp hơn làm cho cử chỉ nhạy hơn. Giá trị cao hơn yêu cầu vuốt dài hơn. Áp dụng cho cả xem trước trên dock và trình chuyển đổi cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值越低，手势就越敏感。更高的值需要更长的滑动时间。同时适用于 Dock 预览和窗口切换器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低數值會使手上更加靈敏。高數值需要更長的滑動來觸發。這會套用到Dock預覽和視窗切換器。"
          }
        }
      }
    },
