    "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje ovládací tlačítka okna jako zavřít, minimalizovat a další v kompaktním režimu, aby zbylo víc místa pro titulky oken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke die Schließen, Minimieren und andere Fenstersteuerelemente im Kompaktmodus für mehr Platz für den Fenstertitel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta los botones de cerrar, minimizar y otros controles de ventanas en modo compacto para proporcionar más espacio para los títulos de las ventanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides the close, minimize, and other window control buttons in compact mode to provide more room for window titles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les boutons de commande de fenêtres, de fermeture, de minimisation et d'autres boutons de commande de fenêtre en mode compact pour offrir plus de place pour les titres de fenêtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את כפתורי הסגירה, המזעור ופקדי חלון אחרים במצב קומפקטי כדי לספק יותר מקום לכותרות חלונות."
          }
        },
        "hi" : {
