        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita i widget per determinate applicazioni e mantieni le anteprime normali. Utile per i browser che espongono le sessioni multimediali come quelle di YouTube."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアプリのプレビューは維持したまま、Dock上のホバーウィジェットを無効にします。YouTubeのようにメディアセッションを表示するブラウザなどで便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel de zwevende widgets in het Dock uit voor geselecteerde apps, terwijl de normale previews behouden blijven. Handig voor browsers die mediasessies weergeven, zoals YouTube."
          }
        },
        "no" : {
          "stringUnit" : {
