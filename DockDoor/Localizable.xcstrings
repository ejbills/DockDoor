          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar widgets de sobreposição da Dock nas aplicações selecionadas. Útil para navegadores que expõem sessões de multimédia, como por exemplo o YouTube."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить виджеты при наведении курсора для выбранных приложений, сохраняя их обычные превью. Полезно для браузеров, в которых запущены медиа-сессии, например YouTube."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen uygulamalar için dock üzerine gelindiğinde açılan widget'ları devre dışı bırakırken, normal önizlemelerini koruyun. YouTube gibi medya oturumlarını görüntüleyen tarayıcılar için kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable dock hover widgets for selected apps while keeping their regular previews. Useful for browsers that expose media sessions like YouTube."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt tiện ích xem trước khi di chuột qua Dock đối với các ứng dụng được chọn, trong khi vẫn giữ nguyên chế độ xem trước thông thường. Hữu ích cho các trình duyệt có phiên phát nhạc như YouTube."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为选中的应用关闭 Dock 悬停小组件，保留常规预览。对 YouTube 等暴露媒体会话的浏览器很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用特定App的指標停留小工具，並顯示其普通預覽。對於YouTube等暴露媒體階段的瀏覽器有幫助。"
          }
        }
      }
    },
