    "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden alle Fenster aller Instanzen einer App angezeigt, wenn der Mauszeiger auf dem Dock-Icon dieser schwebt. Wenn deaktiviert, werden nur Fenster der spezifischen Instanz der App angezeigt, auf welcher der Mauszeiger schwebt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, pasar el cursor sobre una aplicación en el dock mostrará las ventanas de todas las instancias de esa aplicación. Cuando está deshabilitado, solo se mostrarán las ventanas para la instancia específica bajo el ratón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, survoler une application dans le Dock affiche les fenêtres de toutes les instances de celle-ci. Quand l’option est désactivée, n’affiche que les fenêtres de l’instance spécifique sous la souris."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מופעל, ריחוף מעל יישום ב-Dock מציג חלונות מכל המופעים של היישום הזה. כאשר מושבת, מציג רק חלונות מהמופע הספציפי מתחת לעכבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a Dockon egy alkalmazás fölé vitt egér az adott alkalmazás összes példányának ablakait mutatja. Ha ki van kapcsolva, csak az egér alatt lévő konkrét példány ablakai jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al passaggio del puntatore su un'icona del Dock, mostra le finestre da tutte le istanze dell'app. Quando disabilitato, mostra solo le finestre dell'istanza specifica (il comportamento può dipendere dall'app)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、Dockのアプリにカーソルを合わせると、そのアプリのすべてのインスタンスのウィンドウが表示されます。 無効にすると、マウスの下にある特定のインスタンスのウィンドウのみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld, worden bij het aanwijzen van een app in het Dock de vensters van alle exemplaren van die app weergegeven. Wanneer uitgeschakeld, worden alleen de vensters van het specifieke exemplaar onder de muis weergegeven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, hovering over an app in the Dock shows windows from all instances of that app. When disabled, shows only windows from the specific instance under the mouse."
          }
        },
        "pl" : {
          "stringUnit" : {
