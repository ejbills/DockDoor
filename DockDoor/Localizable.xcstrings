          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hagas clic en el botón de abajo, la aplicación se reiniciará y moverá a la barra de menú para ejecutarse en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
