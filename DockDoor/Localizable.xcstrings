            "value" : "Scroll up on a dock icon to bring the app to front, scroll down to hide all its windows."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll up on a dock icon to bring the app to front, scroll down to hide all its windows."
          }
        },
