        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, déplacer la souris sur l’aperçu pendant le fondu ne le réactivera pas. Vous devrez à nouveau survoler l’icône du Dock pour afficher l’aperçu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מופעל, הזזת העכבר בחזרה מעל התצוגה המקדימה במהלך דהייה לא תפעיל אותה מחדש. עליך לרחף מעל סמל ה-Dock שוב כדי להציג את התצוגה המקדימה."
          }
        },
        "hi" : {
          "stringUnit" : {
