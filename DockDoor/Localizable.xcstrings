        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når man klikker på knappen nedenfor, vil DockDoor genstarte og flytte til menubjælken for at køre i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
