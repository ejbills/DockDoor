        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legyintés az ablak-előnézeteken a Dock felugró ablakában. Az irány a Dock pozíciójához viszonyul – legyintsen a Dock irányába (pl. lefelé, ha a Dock alul van; balra, ha a Dock a bal oldalon található)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe on window previews in the dock popup. Direction is relative to dock position — swipe towards the dock (e.g., down when dock is at bottom, left when dock is on left)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri sulle anteprime del Dock. Le direzioni sono 'verso il Dock' o 'in direzione opposta al Dock', (es. giù/su se il Dock è visualizzato in basso, oppure sinistra/destra se il Dock è a sinistra)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockポップアップでウィンドウのプレビューをスワイプします。方向はDockの位置に相対的です — Dockに向かってスワイプ (例：Dockが下にあるときは左に、Dockが下にあるときは左)。"
          }
        },
        "ko" : {
          "stringUnit" : {
