          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij geselecteerde apps wordt alleen het meest recente venster weergegeven. Alle vensters worden weergegeven in de modus ‘Alleen actieve apps’."
          }
        },
