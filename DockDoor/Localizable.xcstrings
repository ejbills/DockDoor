    "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namísto náhledů okna v podporovaných aplikacích (Hudba, Spotify, kalendář) zobrazit interaktivní ovládací prvky při přejetí na Dock."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für unterstützte Apps (Musik, Spotify, Kalender) werden beim Bewegen der Dock-Symbole interaktive Steuerelemente anstelle von Fenstervorschauen angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicaciones soportadas (Music, Spotify, Calendar), muestra controles interactivos en lugar de vistas previas de ventanas al desplazarse sobre sus iconos en el Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les applications prises en charge (Musique, Spotify, Calendrier), affiche des commandes interactives au lieu des aperçus de fenêtre lors du survol de leur icône dans le Dock."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור אפליקציות נתמכות (Music, Spotify, Calendar), הצג פקדים אינטראקטיביים במקום תצוגות מקדימות של חלונות בעת ריחוף מעל סמלי ה-Dock שלהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A támogatott alkalmazásoknál (Zene, Spotify, Naptár) ablak-előnézet helyett interaktív vezérlők jelennek meg, amikor az egérrel a Dock ikonjai fölé viszed a kurzort."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle applicazioni supportate (Musica, Spotify, Calendario), mostra i comandi rapidi al passaggio del mouse sull'icona del Dock al posto dell'anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされているアプリ（ミュージック、Spotify、カレンダー）の場合、Dockアイコンにカーソルを合わせると、ウィンドウのプレビューの代わりに操作可能なコントロールを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 앱(음악, Spotify, 캘린더)의 경우 Dock 아이콘을 가리키면 창 미리보기 대신 대화형 컨트롤을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor ondersteunde apps (Apple Music, Spotify, Agenda) worden interactieve bedieningselementen weergegeven in plaats van venstervoorbeelden wanneer je de muisaanwijzer op hun Dock-pictogrammen plaatst."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos compatíveis (Música, Spotify, Calendário), mostrar controles interativos em vez de pré-visualizações de janela ao passar o mouse sobre seus ícones no Dock."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos compatíveis (Música, Spotify, Calendário), mostrar controles interativos em vez de prévias de janela ao passar o mouse sobre seus ícones no Dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для поддерживаемых приложений (Музыка, Spotify, Календарь) показывать интерактивные элементы управления вместо превью окон при наведении на их иконки в Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For supported apps (Music, Spotify, Calendar), show interactive controls instead of window previews when hovering their Dock icons."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenen uygulamalar (Music, Spotify, Takvim) için, Dock simgelerinin üzerine gelindiğinde pencere önizlemleri yerine etkileşimli kontroller göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для підтримуваних застосунків (Music, Spotify, Календар) показувати інтерактивні елементи керування замість попереднього перегляду вікон під час наведення курсора на їхні іконки в Dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đối với các ứng dụng được hỗ trợ (Music, Spotify, Lịch), hiển thị các điều khiển tương tác thay vì bản xem trước cửa sổ khi di chuột vào biểu tượng của chúng trên Dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于支持的应用（Music、Spotify、Calendar），在悬停其 Dock 图标时显示交互式控制，而不是窗口预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指標停留在Dock圖像上時，對於支援的App（音樂、Spotify、行事曆）顯示控制項目而非視窗預覽。"
          }
        }
      }
    },
