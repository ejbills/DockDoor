    "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte profil pro rychlou úpravu nastavení výkonu. Vyberte \"Pokročilé\" pro ruční úpravu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein Profil aus, um die allgemeinen Leistungseinstellungen schnell anzupassen. Wählen Sie \"Erweitert\" für manuelle Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione un perfil para ajustar rápidamente los ajustes de rendimiento comunes. Elija \"Avanzado\" para el control manual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un profil pour ajuster rapidement les réglages de performance. Sélectionnez « Avancé » pour les modifier manuellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר פרופיל כדי להתאים במהירות הגדרות ביצועים נפוצות. בחר \"מתקדם\" לשליטה ידנית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz egy profilt a gyakori teljesítménybeállítások gyors módosításához. A kézi beállításhoz válaszd a „Haladó” opciót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un profilo per impostare facilmente e rapidamente le opzioni di performance. Clicca su 'Impostazioni avanzate' per configurare tutto manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的なパフォーマンス設定をすばやく調整するにはプロファイルを選択します。手動制御の場合は「詳細」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 선택하면 일반적인 성능 설정을 빠르게 조정할 수 있습니다. 수동으로 제어하려면 '고급'을 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer een profiel om snel algemene prestatie-instellingen aan te passen. Kies 'Geavanceerd' voor handmatige bediening."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um perfil para ajustar as configurações de perfomance. Escolha \"Avançado\" para controlar manualmente"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um perfil para ajustar rapidamente as configurações de desempenho comuns. Escolha \"Avançado\" para controlo manual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a profile to quickly adjust common performance settings. Choose \"Advanced\" for manual control."
          }
        },
        "ru" : {
          "stringUnit" : {
