    "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungují jak levé, tak pravé klávesy Command, Option nebo Control. Můžete také podržet modifikační klávesu a současně stisknout spouštěč, čímž zachytíte obojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowohl linke als auch rechte Command, Option oder Control Tasten funktionieren. Der Modifikator kann gehalten werden, während der Trigger gedrückt wird, um beides aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas de comando, opción o control izquierdo o derecho funcionan. También puede mantener pulsado el modificador mientras presiona el disparador para capturar ambos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches Commande gauche, droite, Option et Contrôle fonctionnent. Vous pouvez également maintenir le modificateur tout en pressant le déclencheur pour capturer les deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקשי Command, Option או Control שמאליים או ימניים עובדים. אתה יכול גם להחזיק את מקש השינוי בזמן לחיצה על ההדק כדי ללכוד את שניהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bal vagy jobb Command, Option vagy Control billentyű egyaránt használható.\nA módosítóbillentyűt lenyomva is tarthatod, miközben megnyomod a triggert – így mindkettő rögzítésre kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono validi entrambi i tasti Command (a destra o a sinistra della barra spaziatrice). Puoi anche aggiungere un ulteriore tasto tenendolo premuto insieme al tasto modificatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左または右のCommand、Option、またはControlキーのいずれかが利用できます。両方をキャプチャするためにトリガーを押しながら修飾キーを押したままにすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De linker- of rechter Command-, Option- of Control-toetsen werken. Je kunt de modificatietoets ook ingedrukt houden terwijl je de trigger indrukt om beide vast te leggen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både venstre og høyre kommando, tilvalg eller kontroll-tast fungerer. Du kan også holde modifikatoren mens du trykker på tasten for å fange begge deler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode usar as teclas Command, Option ou Control tanto à esquerda como à direita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работают как левые, так и правые клавиши Command, Option и Control. Можно также удерживать модификатор при нажатии клавиши-триггера, чтобы захватить обе."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Either left or right Command, Option, or Control keys work. You can also hold the modifier while pressing the trigger to capture both."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol veya sağ Command, Option ya da Control tuşlarından herhangi biri kullanılabilir. Ayrıca, tetik tuşuna basarken değiştirici tuşu basılı tutarak her ikisini birden yakalayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працюють як ліва, так і права клавіші Command, Option або Control. Ви також можете утримувати модифікатор під час натискання на тригер, щоб захопити обидві."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím Command, Option hoặc Control bên trái hoặc phải đều hoạt động. Bạn cũng có thể giữ phím bổ trợ trong khi nhấn phím kích hoạt để chụp cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右两侧的 Command、Option 或 Control 键都可用。您也可以在按下触发键的同时按住修饰键，以便同时捕捉这两个动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左或右邊的 Command、Option或Control鍵皆可。你也可以在按下最終鍵的同時按住變更鍵來一次記錄。"
          }
        }
      }
    },
