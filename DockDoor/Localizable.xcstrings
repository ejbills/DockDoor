    "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li vypnuto, zobrazí se speciální ovládací prvky, pouze pokud nejsou k dispozici náhledy oken (např. všechna okna minimalizována). Je-li zapnuto, ovládací prvky se podle možnosti integrují do náhledů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, werden spezielle Steuerelemente nur angezeigt, wenn keine Fenstervorschauen verfügbar sind (z.B. alle Fenster minimiert). Wenn aktiviert, integrieren die Steuerelemente wenn möglich mit den Vorschauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está deshabilitado, los controles especiales sólo aparecen si no hay vistas previas de ventanas disponibles (por ejemplo, todas las ventanas minimizadas). Si está activado, los controles se integran con vistas previas cuando sea posible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si désactivé, les contrôles spéciaux n’apparaissent que si aucun aperçu de fenêtre n’est disponible (par ex. toutes les fenêtres sont minimisées). Si activé, les contrôles sont intégrés avec les aperçus lorsque possible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם מושבת, פקדים מיוחדים מופיעים רק אם אין תצוגות מקדימות של חלונות זמינות (למשל, כל החלונות ממוזערים). אם מופעל, פקדים משתלבים עם תצוגות מקדימות כאשר אפשרי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ki van kapcsolva, a speciális vezérlők csak akkor jelennek meg, ha nincs elérhető ablak-előnézet (pl. minden ablak minimalizálva van).\nHa be van kapcsolva, a vezérlők integrálódnak az  előnézetekkel amikor az lehetséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disabilitato, i controlli speciali appaiono solo se non sono disponibili anteprime delle finestre (ad esempio, tutte le finestre sono minimizzate). Se abilitato, i controlli si integrano con le anteprime quando possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効にすると、ウィンドウのプレビューが使用できない場合にのみ特別なコントロールが表示されます（たとえば、すべてのウィンドウが最小化されている場合）。有効にすると、可能な場合はコントロールがプレビューと統合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비활성화하면 창 미리 보기를 사용할 수 없는 경우(예: 모든 창이 최소화됨)에만 특수 컨트롤이 나타납니다. 활성화하면 가능한 경우 컨트롤이 미리 보기와 통합됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer uitgeschakeld, worden de speciale bedieningselementen alleen weergegeven als er geen venstervoorbeelden beschikbaar zijn (bijvoorbeeld wanneer alle vensters zijn geminimaliseerd). Wanneer ingeschakeld, worden de bedieningselementen waar mogelijk geïntegreerd met de voorbeelden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если отключено, специальные элементы управления появляются только при отсутствии доступных превью окон (например, все окна свёрнуты). Если включено, элементы управления встраиваются в превью при наличии возможности"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, special controls only appear if no window previews are available (e.g., all windows minimized). If enabled, controls integrate with previews when possible."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek devre dışı bırakıldığında, özel denetimler yalnızca pencere önizlemeleri mevcut olmadığında (örneğin, tüm pencereler simge durumuna küçültülmüşse) görünür. Etkinleştirildiğinde ise, denetimler mümkün olduğunda önizlemelerle bütünleşir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вимкнено, спеціальні елементи керування показуються лише за відсутності попереднього перегляду вікон (наприклад, усі вікна згорнуті). Якщо ввімкнено, елементи керування інтегруються з попереднім переглядом, коли це можливо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu tắt, các điều khiển đặc biệt chỉ hiển thị khi không có bản xem trước cửa sổ nào (ví dụ: tất cả cửa sổ đều được thu nhỏ). Nếu bật, các điều khiển sẽ được tích hợp cùng với bản xem trước khi có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，仅在没有窗口预览（如所有窗口最小化）时显示特殊控件。开启时，控件会与预览集成显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若停用本項，特殊控制項目只會在沒有視窗可預覽（例如所有視窗都最小化）時顯示。若啟用本項，控制項目會儘可能和預覽整合。"
          }
        }
      }
    },
