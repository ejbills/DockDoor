          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller, widgetlar, dosya tepsisi, şarkı sözleriyle medya kontrolleri, ve yerleşik bir değiştirici ile macOS Dock'unu değiştiren ayrı ücretli bir uygulama."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрема, платна програма, яка повністю замінює Dock у macOS з профілями, віджетами, полицею для файлів, керування медіа з текстами пісень і вбудованим перемикачем програм."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ứng dụng trả phí riêng biệt giúp thay thế hoàn toàn Dock trên macOS, với các tính năng bao gồm: hồ sơ, tiện ích, khay chứa tệp, điều khiển phát nhạc kèm hiển thị lời bài hát, và bộ chuyển đổi ứng dụng tích hợp sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款独立的付费应用，可完全取代 macOS Dock，提供多种配置方案、小组件、文件托盘、带歌词的媒体控制以及内置的应用切换器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個收費的App，用來取代整個macOS的Dock，並提供設定檔、小工具、檔案匣、含歌詞的媒體控制項目與內建的切換器。"
          }
        }
      }
    },
