    "Selected apps show only their most recent window. All windows shown in active-app-only mode." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané aplikace zobrazí pouze své poslední okno. Všechna okna se zobrazí v režimu \"pouze aktivní aplikace\"."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Apps zeigen nur das aktuellste Fenster an. Alle Fenster werden im \"Nur aktive Apps\"-Modus angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
