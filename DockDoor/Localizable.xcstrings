    "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher." : {
      "comment" : "DockDoor Pro banner description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samostatná placená aplikace, která plně nahrazuje Dock macOS s profily, widgety, lištou souborů, ovládáním médií s texty a vestavěným přepínačem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine separate kostenpflichtige App, die das MacOS-Dock vollständig durch Profile, Widgets, Datei-Ablage, Mediensteuerung mit Songtexten und einem integrierten Wechsler ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una aplicación de pago separada que reemplaza completamente el dock macOS con perfiles, widgets, bandeja de archivos, controles multimedia con letras y un selector incorporado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erillinen maksullinen sovellus, joka täysin korvaa MacOS telakan profileilla, widgeteillä, "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפליקציה נפרדת שמחליפה לחלוטין את macOS Dock עם פרופילים, ווידג'טים, מגש קבצים, פקדי מדיה עם מילים ומתג מובנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'app premium separata (a pagamento) che sostituisce completamente il Dock per aggiungere profili, widget, vassoi di file, controlli multimediali con testi e un interruttore incorporato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacOSのDockを完全に置き換える有料アプリで、プロファイル、ウィジェット、ファイルトレイ、歌詞表示付きメディアコントロール、および内蔵のスイッチャーを備えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필, 위젯, 파일 트레이, 가사가 표시되는 미디어 컨트롤, 내장 전환기로 macOS Dock을 완전히 대체하는 별도의 유료 앱입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een afzonderlijke betaalde app die de macOS Dock volledig vervangt door profielen, widgets, bestandsvak, mediabediening met songteksten, en een ingebouwde wisselaar."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobna płatna aplikacja, która w pełni zastępuje Dock systemu macOS, oferując profile, widżety, tackę z plikami, elementy sterujące multimediami z tekstem utworów oraz wbudowany przełącznik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A separate paid app that fully replaces the macOS Dock with profiles, widgets, file tray, media controls with lyrics, and a built-in switcher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
