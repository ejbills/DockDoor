          "stringUnit" : {
            "state" : "new",
            "value" : "Selected apps show only their most recent window. All windows shown in active-app-only mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications sélectionnées n'affichent que leur fenêtre la plus récente. Toutes les fenêtres sont affichées en mode app active uniquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יישומים שנבחרו מציגים רק את החלון האחרון שלהם. כל החלונות מוצגים במצב יישום פעיל בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
