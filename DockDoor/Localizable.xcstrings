    "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce Zafixování Docku funguje nejlépe, pokud je v konfiguraci s více monitory Dock umístěn ve spodní části obrazovky a je zapnuta možnost „Monitorům jsou přiřazeny samostatné plochy“ v Nastavení systému → Plocha a Dock → Mission Control. Pokud je tato funkce zapnutá, Dock se nepřesune na jiný monitor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-Sperren funktioniert in einem Multi-Monitor-Setup mit einem unten positionierten Dock am besten, wenn \"Monitore verwenden verschiedene Spaces\" in den Systemeinstellungen unter Schreibtisch & Dock -> Mission Control aktiviert ist. Wenn diese Einstellung aktiviert ist, springt das Dock nicht zu anderen Monitoren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco del Dock funziona al meglio se il Dock è posizionato in basso e nella configurazione multi-monitor l'opzione 'Gli schermi hanno spazi separati' è attiva (Impostazioni di sistema → Scrivania & Dock → Mission Control). Con questa funzione attiva, il Dock non passerà da uno schermo all'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockのロック機能は、システム設定の「デスクトップとDock」内にあるMission Controlで「ディスプレイごとに別のSpaceがある」を有効にしているマルチモニター環境において、画面下部に配置したDockで使用すると最も効果的です。この機能を有効にしている間、Dockが他のモニターへ移動することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-vergrendeling werkt het beste wanneer het Dock onderaan het scherm staat in een opstelling met meerdere beeldschermen, waarbij de optie “Beeldschermen hebben afzonderlijke spaces” is ingeschakeld in Systeeminstellingen → Bureaublad en Dock → Mission Control. Zolang deze functie is ingeschakeld, springt het Dock niet naar een ander beeldscherm."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio da Dock funciona melhor com uma Dock posicionada na parte inferior, numa configuração de vários monitores onde a opção \"Os ecrãs têm Spaces separados\" está ativa nas Definições do Sistema → Secretária e Dock → Mission Control. A Dock não saltará para outro monitor enquanto esta funcionalidade estiver ativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка расположения Dock лучше всего работает с нижним расположением Dock в мультимониторной конфигурации, где включена позиция \"Дисплеи с разными рабочими пространствами Spaces\" в Системные настройки → Рабочий стол и Dock → Mission Control. Когда эта функция включена, Dock не будет перескакивать на другой монитор."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock Kilitleme özelliği, Sistem Ayarları → Masaüstü ve Dock → Mission Control bölümünde “Ekranlar ayrı Alanlara sahip” seçeneğinin etkinleştirildiği çoklu monitör kurulumlarında, Dock alt konumda olduğunda en iyi şekilde çalışır. Bu özellik etkinken Dock başka bir monitöre geçmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dock Locking works best with a bottom-positioned Dock in a multi-monitor setup where \"Displays have separate Spaces\" is enabled in System Settings → Desktop & Dock → Mission Control. The Dock won't jump to another monitor while this feature is enabled."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa Dock hoạt động tốt nhất với Dock được đặt ở dưới cùng trong thiết lập nhiều màn hình nơi tùy chọn \"Màn hình có các Không gian riêng biệt\" được bật trong Cài đặt hệ thống → Màn hình nền & Dock → Mission Control. Dock sẽ không nhảy sang màn hình khác khi tính năng này được bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置 → 桌面和 Dock → 任务控制”中启用“显示有单独的空间”的多显示器设置中，Dock 锁定在底部位置的 Dock 中效果最好。启用此功能时，Dock 不会跳转到另一个监视器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock鎖定功能在當你有多部顯示器，且在系統設定→桌面與Dock→指揮中心內啟用「顯示器有單獨空間」，並將Dock放置於底部時表現最佳。啟用時，Dock將不會隨焦點移動到不同顯示器。"
          }
        }
      }
    },
