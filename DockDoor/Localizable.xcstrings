    "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte velikost náhledů oken při najetí na ikony v Docku. Všechny obrázky náhledů jsou automaticky škálované, aby se vešly do zvolené velikosti a zachovaly si původní poměr stran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor store vinduesforhåndsvisninger skal vises, når du holder musen over dock-ikoner. Alle vinduesbilleder skaleres automatisk til at passe inden for denne størrelse, samtidig med at deres oprindelige proportioner bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie große Fenstervorschauen angezeigt werden, wenn der Mauszeiger über die Dock-Icons schwebt. Alle Fensterbilder werden automatisch skaliert, um in diese Größe zu passen, ohne die ursprünglichen Proportionen zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija cómo aparecen las vistas previas de las ventanas grandes al pasar el cursor sobre los iconos de los muelles. Todas las imágenes de las ventanas se escalan automáticamente para que encajen dentro de este tamaño manteniendo sus proporciones originales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la taille d’affichage des aperçus des fenêtres au survol des icônes du Dock. Toutes les images des fenêtres sont automatiquement redimensionnées pour s’adapter à cette taille tout en conservant leurs proportions d’origine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר באיזה גודל תצוגות מקדימות של חלונות מופיעות בעת ריחוף מעל סמלי Dock. כל תמונות החלונות מותאמות אוטומטית לגודל זה תוך שמירה על הפרופורציות המקוריות שלהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, mekkora legyen az ablak-előnézetek mérete a dock ikonok fölé húzva az egérrel. A képek automatikusan igazodnak ehhez a mérethez, az arányok megtartásával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni delle anteprime del Dock. Le immagini delle finestre sono scalate automaticamente per adattarsi a questa dimensione mantenendo le proporzioni originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockアイコンにカーソルを合わせると、ウィンドウのプレビューがどのように大きく表示されるかを選択します。 すべてのウィンドウ画像は、元の比率を維持しながら、このサイズに合わせて自動的にスケーリングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe groot de venstervoorbeelden worden weergegeven wanneer de muis over Dock-pictogrammen beweegt. Alle vensterafbeeldingen worden automatisch aangepast aan dit formaat, waarbij de oorspronkelijke verhoudingen behouden blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvor store vindusforhåndsvisninger vises ved sveving over dock-ikoner. Alle vindusbildene blir automatisk skalert ned til å passe innenfor denne størrelsen og opprettholde de opprinnelige andelene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak duży będzie podgląd okna po najechaniu kursorem na ikony w Docku. Wszystkie obrazy okien są automatycznie skalowane, aby pasowały do ​​tego rozmiaru, zachowując jednocześnie oryginalne proporcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quão grande é a visualização das janelas ao passar o rato sobre os ícones da Dock. Todas as janelas são redimensionadas automaticamente para caber dentro deste tamanho, mantendo as suas proporções originais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите размер превью окон при наведении на иконки в Dock. Все изображения автоматически масштабируются под этот размер с сохранением пропорций."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose how large window previews appear when hovering over dock icons. All window images are automatically scaled to fit within this size while maintaining their original proportions."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock simgelerinin üzerine fareyi getirdiğinizde pencere önizlemelerinin ne kadar büyük görüneceğini seçin. Tüm pencere görüntüleri, orijinal oranları korunarak bu boyuta sığacak şekilde otomatik olarak ölçeklendirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, наскільки великими будуть попередні перегляди вікон під час наведення курсора на іконки в Dock. Усі зображення вікон автоматично масштабуються відповідно до цього розміру, зберігаючи при цьому свої початкові пропорції."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
