          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在紧凑模式下隐藏关闭、最小化和其他窗口控制按钮，为窗口标题提供更多空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在精簡模式下隱藏關閉、最小化及其他視窗控制按鈕，用更多空間來顯示視窗標題。"
          }
        }
      }
    },
