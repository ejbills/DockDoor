    "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte prahovou hodnotu počtu oken aplikace, po které se přepnou do kompaktního režimu. Zadáním 0 se možnost vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege einen Schwellenwert fester, bei dem automatisch in den Kompaktmodus gewechselt wird, wenn eine App genau so viele oder mehr Fenster hat. Auf 0 setzen, um das Feature zu deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un seuil pour basculer automatiquement en mode compact lorsqu'une application a autant de fenêtres ou plus. Régler sur 0 pour désactiver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר סף למעבר אוטומטי למצב קומפקטי כאשר ליישום יש כמות זו או יותר חלונות. הגדר ל-0 כדי להשבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a threshold to automatically switch to compact mode when an app has that many or more windows. Set to 0 to disable."
          }
        },
