          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauter le petit délai avant que le sélecteur n'apparaisse. Plus rapide, mais peut causer des flashs lumineux si vous relâchez rapidement la clé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דלג על העיכוב הקטן לפני שהבורר מופיע. עשוי להרגיש זריז יותר אך עלול לגרום להבהוב אם תשחרר את המקש במהירות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A váltó megjelenése előtti rövid késleltetés kihagyása. Gyorsabbnak érződhet, de a gomb gyors felengedése esetén villogást okozhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il selettore finestre senza il breve ritardo predefinito. Velocità e fluidità potrebbero apparire migliori, ma se si lascia rapidamente il tasto della scorciatoia potrebbe verificarsi uno sfarfallio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイッチャーが表示される前のわずかな遅延をスキップします。反応が速く感じられるかもしれませんが、キーを素早く離すとちらつきが発生する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla de korte vertraging over voordat de schakelaar verschijnt. Dit voelt misschien vlotter aan, maar kan flikkeringen veroorzaken als je de toets snel loslaat."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o pequeno atraso até o selecionador de janelas aparecer. Pode parecer mais rápido, mas pode também fazer com que a janela pisque se largar a tecla rapidamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустить небольшую задержку перед появлением переключателя. Может работать отзывчивее, но при быстром отпускании клавиши возможно мерцание"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip the small delay before the switcher appears. May feel snappier but can cause flickering if you quickly release the key."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtarın görünmesinden önceki kısa gecikmeyi atla. Daha hızlı hissettirebilir, ancak tuşu hızla bırakırsan titremeye neden olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустити невелику затримку перед появою перемикача. Може відчуватися різкіше, але може спричинити мерехтіння, якщо швидко відпустити клавішу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua độ trễ nhỏ trước khi trình chuyển đổi xuất hiện. Có thể cảm thấy nhanh hơn nhưng có thể gây nhấp nháy nếu bạn thả phím nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过切换器出现前的小延迟。可能会感觉更流畅，但若快速松开按键可能导致闪烁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳過切換器出現前的微小延遲。感覺比較靈活但太快放開按鍵的話會造成閃爍。"
          }
        }
      }
    },
